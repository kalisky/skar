{
  "name": "@kalisky/skar",
  "version": "0.1.0",
  "description": "Skar turns a captured AI agent trace into a committed pytest regression test. MCP server + CLI. Use when a tool-using agent run fails and you want to lock the failure as an executable test.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "agents",
    "ai-agents",
    "agent-testing",
    "agent-evals",
    "regression-test",
    "regression-testing",
    "pytest",
    "pytest-generator",
    "trace",
    "trace-to-test",
    "tool-use",
    "anthropic",
    "claude",
    "claude-code",
    "cursor",
    "llm-testing"
  ],
  "license": "MIT",
  "author": "Ofer Kalisky",
  "homepage": "https://github.com/kalisky/skar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisky/skar.git"
  },
  "bugs": {
    "url": "https://github.com/kalisky/skar/issues"
  },
  "type": "module",
  "bin": {
    "skar": "./dist/cli/index.js",
    "skar-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "mcp": "tsx src/mcp/server.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
