{
  "schema_version": "0.1",
  "input": {
    "prompt": "Refund order 123 if eligible"
  },
  "events": [
    {
      "type": "tool_call",
      "tool_name": "refund_lookup",
      "arguments": {
        "order_id": "123"
      },
      "result": {
        "eligible": true,
        "order_id": "123"
      }
    },
    {
      "type": "tool_call",
      "tool_name": "refund_create",
      "arguments": {
        "order_id": "123"
      },
      "result": {
        "status": "success",
        "refund_id": "r_123"
      }
    }
  ],
  "final": {
    "status": "success",
    "output_text": "Refund created"
  }
}
